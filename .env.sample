REVERSE_PROXY_PORT=8000

# Required: docker-compose.yml refuses to start without these rather than falling back to the
# published upstream defaults. Generate URL-safe values (they are interpolated into connection
# URLs, so avoid @ / : and #):
#   openssl rand -hex 32
POSTGRES_PASSWORD=
RABBITMQ_USER=safe
RABBITMQ_PASSWORD=

CFG_VERSION=latest
CGW_VERSION=latest
TXS_VERSION=latest
UI_VERSION=latest
EVENTS_VERSION=latest

RPC_NODE_URL=http://url.to.node
