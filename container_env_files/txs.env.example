PYTHONPATH=/app/
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=__CHANGE_ME__
DEBUG=0
# DATABASE_URL and CELERY_BROKER_URL are set by docker-compose.yml from POSTGRES_PASSWORD /
# RABBITMQ_USER / RABBITMQ_PASSWORD in the repo-root .env, and override anything set here --
# the database and broker servers are configured from the same values, so the two sides
# cannot drift. Set them in .env, not here.
DATABASE_URL=psql://postgres:postgres@txs-db:5432/postgres
ETH_L2_NETWORK=1
REDIS_URL=redis://txs-redis:6379/0
CELERY_BROKER_URL=amqp://guest:guest@txs-rabbitmq/
DJANGO_ALLOWED_HOSTS="*"
FORCE_SCRIPT_NAME=/txs/
CSRF_TRUSTED_ORIGINS="http://localhost:8000"
EVENTS_QUEUE_URL=amqp://general-rabbitmq:5672
EVENTS_QUEUE_ASYNC_CONNECTION=True
EVENTS_QUEUE_EXCHANGE_NAME="safe-transaction-service-events"
