# Newest set published for linux/amd64, from: scripts/upgrade_test.sh latest
#
# Checked in deliberately, unlike versions/deployed.env (gitignored): these are the newest tags
# published upstream, which anyone can read off Docker Hub. They say nothing about what any host
# is actually running -- that is the inventory versions/deployed.env.example refuses to publish.
# NOTE: safe-client-gateway-nest is arm64-only from v1.116.0, so v1.115.0 is the amd64 ceiling.
TXS_VERSION=v6.10.1
CFG_VERSION=v2.96.1
CGW_VERSION=v1.115.0
EVENTS_VERSION=v1.5.0
UI_BASE_IMAGE=docker.io/safeglobal/safe-wallet-web:v1.99.1
