# Template. Copy to versions/deployed.env (gitignored) and fill in from YOUR host.
#
# This file records which image versions a deployment is actually running, which is the
# baseline an upgrade rehearsal has to start from (RUNBOOK section 14). It is deliberately
# NOT committed with real values: naming the exact versions a live deployment runs is an
# inventory an attacker can match against known advisories.
#
# Generate it from the host, which is authoritative:
#
#   scripts/upgrade_test.sh probe-host <stack-user>@<host> > versions/deployed.env
#
# If the tags are `latest`, the tag identifies nothing and the digest is the only pinnable
# value -- probe-host emits both. Prefer the digest.
#
# The service versions can also be read over HTTP (`probe`), but the UI and events service
# cannot: the UI has no version endpoint and the app version in its bundle lags the image tag
# by about a release, and the events service reports no version at all.

TXS_VERSION=
CFG_VERSION=
CGW_VERSION=
EVENTS_VERSION=
UI_BASE_IMAGE=docker.io/safeglobal/safe-wallet-web:

# Digests, if the tags above are mutable (`latest`). These are appended to the image
# references in docker-compose.yml, making the digest authoritative.
# TXS_DIGEST=@sha256:...
# CFG_DIGEST=@sha256:...
# CGW_DIGEST=@sha256:...
# EVENTS_DIGEST=@sha256:...
